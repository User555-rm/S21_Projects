# ===================================================================
#  shop.conf. — конфигурация Nginx для задания BE3 (блок Nginx)
# ===================================================================

# --- Формат лога: видно upstream (какой бэкенд) и статус кэша ---
log_format main_ext '$remote_addr - $remote_user [$time_local] "$request" '
                    '$status $body_bytes_sent "$http_referer" '
                    '"$http_user_agent" upstream=$upstream_addr '
                    'cache=$upstream_cache_status';

# ---- Кэширование -------------------------------------------------
proxy_cache_path /var/cache/nginx/shop levels=1:2 keys_zone=shop_cache:10m
                 max_size=10g inactive=60m use_temp_path=off;

# ---- Балансировка GET /api/v1: 2:1:1 ------------------------------
upstream shop_backends {
    server 127.0.0.1:8081 weight=2;  # основной (запись/чтение)
    server 127.0.0.1:8082 weight=1;  # read-only
    server 127.0.0.1:8083 weight=1;  # read-only
}

# Записи (POST/PATCH/DELETE) всегда на главный инстанс
upstream shop_main {
    server 127.0.0.1:8081;
}

# ---- Пул для Swagger (всегда на основной) ----
upstream swagger_backend {
    server 127.0.0.1:8081;
}

# ---- Редирект HTTP -> HTTPS ----------------------------------------
server {
    listen 80;
    server_name shop.local;
    return 301 https://shop.local$request_uri;
}

# ===================================================================
#  Основной HTTPS-сервер
# ===================================================================
server {
    listen 443 ssl http2;
    server_name shop.local;

    access_log /var/log/nginx/access.log main_ext;
    error_log /var/log/nginx/error.log;

    # --- TLS / HTTPS ---
    ssl_certificate     /etc/nginx/ssl/shop.local.crt;
    ssl_certificate_key /etc/nginx/ssl/shop.local.key;
    ssl_protocols       TLSv1.2 TLSv1.3;
    ssl_ciphers         HIGH:!aNULL:!MD5;
    ssl_prefer_server_ciphers on;

    # --- gzip-сжатие ----------------------------------------------
    gzip on;
    gzip_vary on;
    gzip_proxied any;
    gzip_comp_level 6;
    gzip_buffers 16 8k;
    gzip_http_version 1.1;
    gzip_min_length 1100;
    gzip_disable "msie6";
    # Медиа-типы исключены (jpeg, png, gif, webp, avif, mp4)
    gzip_types text/plain text/css application/json application/javascript
               text/xml application/xml application/xml+rss text/javascript
               application/vnd.ms-fontobject application/x-font-ttf
               font/opentype image/svg+xml image/x-icon;

    # --- Статика по / (корень раздачи) -----------------------------
    root /var/www/shop;
    index index.html;

    # Статические файлы: отдаём из диска + кэшируем на клиенте
    location ~* \.(css|js|svg|woff2?|ttf|eot|ico|jpe?g|png|gif|webp|avif|mp4)$ {
        try_files $uri =404;
        expires 1d;
        add_header Cache-Control "public, max-age=86400";
        access_log off;
    }

    # --- index.html и другие HTML файлы ---
    location / {
        try_files $uri $uri/ =404;
    }

    # --- Страница статуса nginx ---
    location = /status {
        stub_status;
        access_log off;
        allow 127.0.0.1;
        deny all;
    }

    # --- /admin -> pgAdmin ---
    location ^~ /admin/ {
        proxy_pass http://127.0.0.1:5050/;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header X-Script-Name /admin;
        
        # Кэшируем GET запросы к /admin
        proxy_cache shop_cache;
        proxy_cache_key "$scheme$request_method$host$request_uri";
        proxy_cache_valid 200 302 1m;
        proxy_cache_use_stale error timeout updating http_500 http_502 http_503 http_504;
        proxy_cache_methods GET HEAD;
    }

    # --- Swagger UI (доступ по /swagger-ui/) ---
    location ^~ /swagger-ui/ {
        proxy_pass http://swagger_backend$uri;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header X-Forwarded-Host $host;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        
        # Кэшируем GET запросы к Swagger
        proxy_cache shop_cache;
        proxy_cache_key "$scheme$request_method$host$request_uri";
        proxy_cache_valid 200 302 1m;
        proxy_cache_use_stale error timeout updating http_500 http_502 http_503 http_504;
        proxy_cache_methods GET HEAD;
    }

    # --- OpenAPI документация ---
    location ^~ /v3/api-docs {
        proxy_pass http://swagger_backend$uri;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header X-Forwarded-Host $host;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        
        # Кэшируем GET запросы к API-документации
        proxy_cache shop_cache;
        proxy_cache_key "$scheme$request_method$host$request_uri";
        proxy_cache_valid 200 1m;
        proxy_cache_use_stale error timeout updating http_500 http_502 http_503 http_504;
        proxy_cache_methods GET HEAD;

        add_header X-Cache-Status $upstream_cache_status;
        add_header X-Proxy-Cache $upstream_cache_status;
    }

    # ==============================================================
    #  API: маршрутизация и балансировка
    # ==============================================================

    # --- Корень /api/v1/ -> Swagger UI (редирект) ---
    location = /api/v1/ {
        return 302 /swagger-ui/index.html;
    }

    # --- /api/v1 без слеша -> редирект на /api/v1/ ---
    location = /api/v1 {
        return 301 /api/v1/;
    }

    # --- Основной API с балансировкой и кэшированием ---
    location ^~ /api/v1/ {
        # Определяем upstream в зависимости от метода
        set $api_backend "";
        if ($request_method = GET) {
            set $api_backend "http://shop_backends";
        }
        if ($request_method != GET) {
            set $api_backend "http://shop_main";
        }
        
        proxy_pass $api_backend$request_uri;
        proxy_set_header Host "$host";
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;        
        
    }

    # --- Редирект /api/X -> /api/v1/X ---
    location ~ ^/api/(?!(v1|v2)(/|$))(?<apipath>.+)$ {
        return 301 /api/v1/$apipath$is_args$args;
    }

    # --- Редирект /api -> /api/v1/ ---
    location = /api {
        return 301 /api/v1/;
    }
}