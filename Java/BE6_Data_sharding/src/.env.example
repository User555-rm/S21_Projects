# ==============================================================================
#  .env.example — ШАБЛОН переменных окружения для BE6 (Data Sharding)
# ------------------------------------------------------------------------------
#  Как использовать:
#    1) Скопируй в рабочий файл:   cp .env.example .env
#    2) Заполни GOOGLE_CLIENT_ID / GOOGLE_CLIENT_SECRET из Google Cloud Console.
#    3) БЕЗОПАСНОСТЬ: файл .env НЕ коммитить в git (добавь его в .gitignore).
#  Значения из этого файла читает src/compose.yaml (подстановка ${ИМЯ}).
# ==============================================================================

# --- PostgreSQL: общий пароль для postgres / api / image-service ---------------
DB_PASSWORD=555

# --- Google OAuth 2.0 -----------------------------------------------------------
# Где взять: https://console.cloud.google.com → APIs & Services → Credentials
#            → Create Credentials → OAuth client ID → тип "Web application".
# В "Authorized redirect URIs" обязательно добавить ${REDIRECT_URI}.
GOOGLE_CLIENT_ID=xxxxx.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=GOCSPX-xxxxxxxxxxxx
REDIRECT_URI=http://localhost:8080/login/oauth2/code/google

# --- JWT (секрет подписи токенов Shop API) -------------------------------------
# Минимум 32 символа, лучше длинная случайная строка:
#   openssl rand -base64 48
JWT_SECRET=change-me-to-a-long-random-string

# чтобы выбрать в браузере свой гугл аккаунт перейти по url:
# http://localhost:8080/oauth2/authorization/google