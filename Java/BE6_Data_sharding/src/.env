# ==============================================================================
#  .env — рабочие переменные окружения для BE6 (Data Sharding)
# ------------------------------------------------------------------------------
#  ВНИМАНИЕ: файл содержит секреты — НЕ коммитить в git!
#  Заполни GOOGLE_CLIENT_ID / GOOGLE_CLIENT_SECRET из Google Cloud Console.
# ==============================================================================

# --- PostgreSQL: общий пароль для postgres / api / image-service ---------------
DB_PASSWORD=555

# --- Google OAuth 2.0 -----------------------------------------------------------
# Где взять: https://console.cloud.google.com → APIs & Services → Credentials
#            → Create Credentials → OAuth client ID → тип "Web application".
# В "Authorized redirect URIs" укажи ${REDIRECT_URI}.
GOOGLE_CLIENT_ID=329985816158-4o8s7jum24obdv7l6ena4i1msngv8cv7.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=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
REDIRECT_URI=http://localhost:8080/login/oauth2/code/google

# чтобы выбрать в браузере свой гугл аккаунт перейти по url:
# http://localhost:8080/oauth2/authorization/google

# --- JWT (секрет подписи токенов Shop API) -------------------------------------
# Сгенерирован случайно; при желании можно заменить.
JWT_SECRET=G0tQAtfsZIAalingGwVF6Suozi1DjbcKXIthZxKJvDFLvBQyHvkflfG6tZi9TTy5